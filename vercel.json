{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/fishinglookup/:path*", "destination": "/fishing-lookup/:path*", "permanent": true },
    { "source": "/bcnm-tool", "destination": "/bcnm/profit", "permanent": true },
    { "source": "/fishing-cooking", "destination": "/guides/fishing-cooking", "permanent": true },
    { "source": "/fishing-101", "destination": "/guides/fishing-101", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/calculator",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
