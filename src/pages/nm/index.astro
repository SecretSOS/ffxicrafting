---
import Layout from '@components/Layout.astro';
import ItemLink from '@components/ItemLink.astro';
import { getAllNMs } from '@lib/db';
import { pretty, slugify, fmtPct } from '@lib/utils';

const nms = getAllNMs();

const zones = new Map<string, typeof nms>();
for (const nm of nms) {
  if (!zones.has(nm.zone)) zones.set(nm.zone, []);
  zones.get(nm.zone)!.push(nm);
}
const sortedZones = [...zones.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const totalDrops = nms.reduce((s, nm) => s + nm.drops.length + nm.steals.length, 0);
const craftingNMs = nms.filter(nm => nm.drops.some(d => d.is_ingredient) || nm.steals.some(d => d.is_ingredient));
---

<Layout
  title="Notorious Monsters · Phoenix era 75"
  description={`${nms.length} notorious monsters across ${zones.size} zones with ${totalDrops} item drops for crafting and profit.`}
  activeNav="nm"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'NMs' }]}
>
  <div class="page-header">
    <h1>Notorious Monsters</h1>
    <img src="/img/nms.png" alt="Hunting Notorious Monsters" class="page-art">
    <p class="dek">{nms.length} NMs across {zones.size} zones. {craftingNMs.length} drop at least one recipe ingredient. Crafting drops are highlighted.</p>
  </div>

  <div class="nm-controls">
    <input class="filter-input" type="text" placeholder="Filter by NM name, zone, or item…" id="nmFilter" />
    <label class="toggle-label">
      <input type="checkbox" id="craftOnly" />
      Crafting drops only
    </label>
  </div>

  <div id="nmList">
    {sortedZones.map(([zone, zoneNMs]) => (
      <div class="nm-zone-group" data-zone={zone}>
        <h2 class="nm-zone-head">
          <a href={`/zone/${slugify(zone)}`}>{pretty(zone)}</a>
          <span class="nm-zone-count">{zoneNMs.length}</span>
        </h2>
        {zoneNMs.map(nm => {
          const hasCrafting = nm.drops.some(d => d.is_ingredient) || nm.steals.some(d => d.is_ingredient);
          return (
            <details class="nm-entry" data-crafting={hasCrafting ? 'yes' : 'no'}>
              <summary class="nm-summary">
                <span class="nm-name">{pretty(nm.mob)}</span>
                {nm.level_lo != null && (
                  <span class="nm-lv">
                    Lv {nm.level_lo}{nm.level_hi && nm.level_hi !== nm.level_lo ? `–${nm.level_hi}` : ''}
                  </span>
                )}
                {nm.gate.includes('lottery') && <span class="badge">Lottery</span>}
                {hasCrafting && <span class="badge badge-craft">Crafting</span>}
                <span class="nm-drop-count">{nm.drops.length} drop{nm.drops.length !== 1 ? 's' : ''}</span>
              </summary>
              <div class="nm-body">
                {nm.drops.length > 0 && (
                  <table>
                    <thead><tr><th>Drop</th><th>Rate</th></tr></thead>
                    <tbody>
                      {nm.drops.map(d => (
                        <tr class={d.is_ingredient ? 'crafting-row' : ''}>
                          <td><ItemLink id={d.item_id} name={pretty(d.item_name)} /></td>
                          <td class="pct">{fmtPct(d.pct)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {nm.steals.length > 0 && (
                  <>
                    <h4 class="steal-head">Stealable</h4>
                    <table>
                      <thead><tr><th>Item</th><th>Rate</th></tr></thead>
                      <tbody>
                        {nm.steals.map(d => (
                          <tr class={d.is_ingredient ? 'crafting-row' : ''}>
                            <td><ItemLink id={d.item_id} name={pretty(d.item_name)} /></td>
                            <td class="pct">{fmtPct(d.pct)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </>
                )}
              </div>
            </details>
          );
        })}
      </div>
    ))}
  </div>
</Layout>

<script is:inline>
(function(){
  var filter = document.getElementById('nmFilter');
  var craftOnly = document.getElementById('craftOnly');
  var list = document.getElementById('nmList');
  if (!filter || !craftOnly || !list) return;

  function applyFilters() {
    var q = filter.value.toLowerCase();
    var craft = craftOnly.checked;
    var groups = list.querySelectorAll('.nm-zone-group');

    groups.forEach(function(g) {
      var entries = g.querySelectorAll('.nm-entry');
      var anyVisible = false;

      entries.forEach(function(e) {
        var text = e.textContent.toLowerCase();
        var isCrafting = e.getAttribute('data-crafting') === 'yes';
        var matchesText = !q || text.indexOf(q) >= 0;
        var matchesCraft = !craft || isCrafting;
        var show = matchesText && matchesCraft;
        e.style.display = show ? '' : 'none';
        if (show) anyVisible = true;
      });

      g.style.display = anyVisible ? '' : 'none';
    });
  }

  filter.addEventListener('input', applyFilters);
  craftOnly.addEventListener('change', applyFilters);
})();
</script>

<style>
.nm-controls {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.filter-input {
  font-family: var(--font-mono);
  font-size: .82rem;
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 7px 14px;
  background: transparent;
  width: 340px;
  max-width: 100%;
}
.filter-input:focus { border-color: var(--accent); outline: none; }

.toggle-label {
  font-size: .85rem;
  color: var(--ink-soft);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
}
.toggle-label input[type="checkbox"] {
  accent-color: var(--accent);
  width: 16px;
  height: 16px;
}

.nm-zone-group {
  margin-bottom: 8px;
}
.nm-zone-head {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 18px;
  margin: 24px 0 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
}
.nm-zone-head a { color: var(--ink); }
.nm-zone-head a:hover { color: var(--accent); }
.nm-zone-count {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--ink-faint);
  margin-left: 8px;
}

.nm-entry { margin-bottom: 2px; }
.nm-summary {
  cursor: pointer;
  font-size: .92rem;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  color: var(--ink);
  list-style: none;
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
.nm-summary::-webkit-details-marker { display: none; }
.nm-summary::before {
  content: "\25B6";
  display: inline-block;
  margin-right: 4px;
  font-size: .6em;
  transition: transform .15s;
  color: var(--ink-faint);
}
details.nm-entry[open] .nm-summary::before { transform: rotate(90deg); }

.nm-name {
  font-family: var(--font-display);
  font-weight: 500;
  color: var(--accent);
}
.nm-lv {
  color: var(--ink-faint);
  font-size: .82rem;
}
.nm-drop-count {
  color: var(--ink-faint);
  font-size: .78rem;
  margin-left: auto;
}

.badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .06em;
  text-transform: uppercase;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 2px 7px;
  color: var(--ink-faint);
}
.badge-craft {
  border-color: var(--gain);
  color: var(--gain);
}

.nm-body {
  padding: 8px 0 16px 18px;
}
.nm-body table {
  width: 100%;
  max-width: 500px;
}
.nm-body th {
  font-size: 10px;
  padding: 0 10px 6px;
}
.nm-body td {
  padding: 5px 10px;
  font-size: .88rem;
}
.crafting-row td:first-child {
  position: relative;
  padding-left: 18px;
}
.crafting-row td:first-child::before {
  content: "";
  position: absolute;
  left: 4px;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gain);
}

.steal-head {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: .85rem;
  color: var(--ink-soft);
  margin: 12px 0 4px;
}

@media (max-width: 600px) {
  .nm-controls { flex-direction: column; align-items: flex-start; }
  .filter-input { width: 100%; }
}
</style>
