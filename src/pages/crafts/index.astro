---
import Layout from '@components/Layout.astro';
import ItemLink from '@components/ItemLink.astro';
import { CRAFTS_ORDERED, getCraftStats } from '@lib/db';

const crafts = CRAFTS_ORDERED.map(c => ({
  ...c,
  slug: c.name.toLowerCase(),
  stats: getCraftStats(c.code),
}));
---

<Layout
  title="Crafts · Phoenix era 75"
  description="All eight crafts with recipe counts, skill-up brackets, and links to guild details."
  activeNav="crafts"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Crafts' }]}
>
  <h1>Crafts</h1>
  <p class="dek">Eight crafts, skill 1 to 60. Each card shows era recipe counts and links to guild details, calculator, and profit finder.</p>

  <div class="craft-grid">
    {crafts.map(c => (
      <a class="craft-card" href={`/crafts/${c.slug}`} style={`--c:var(${c.cssVar})`}>
        <div>
          <h3>{c.name}</h3>
          <div class="craft-meta">
            <strong>{c.stats.era60}</strong> recipes (1–60)<br />
            <strong>{c.stats.total}</strong> total &middot; <strong>{c.stats.desynth}</strong> desynth
          </div>
          <div class="craft-links">
            <span class="craft-link-pill">Guild &amp; details</span>
            <span class="craft-link-pill">Calculator</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <div class="panel" style="padding:28px">
    <h2>How crafting works</h2>
    <p style="color:var(--ink-soft);line-height:1.7">Every synth needs a crystal, a recipe you've learned (or can attempt within your skill range), and the listed ingredients. Success and HQ chances depend on how your skill compares to the recipe level — all rates are from <code>synthutils.cpp</code> in the server source.</p>
    <ul style="color:var(--ink-soft);line-height:1.8;padding-left:20px">
      <li><strong style="color:var(--ink)">Success:</strong> 95% at or above recipe level, dropping 5%/level for 1–3 below, 10%/level beyond.</li>
      <li><strong style="color:var(--ink)">Skill-ups:</strong> only when the recipe sits above your skill. 60% chance under 50, 25% at 50+.</li>
      <li><strong style="color:var(--ink)">HQ:</strong> needs skill &ge; recipe level. 1.56% at 0–10 above, 6.25% at 11–30, 25% at 31–50, 50% at 51+.</li>
      <li><strong style="color:var(--ink)">Specialization:</strong> every craft shares a free cap (600 for era servers). Above that, all crafts pull from a shared pool of 400 points.</li>
    </ul>
    <p style="color:var(--ink-soft)">The <a href="/calculator">calculator</a> uses these formulas to show the real cost per skill level for every recipe.</p>
  </div>
</Layout>

<style>
.craft-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
}
.craft-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  text-decoration: none;
  color: var(--ink);
  transition: border-color .15s;
}
.craft-card:hover {
  border-color: var(--c);
  text-decoration: none;
}
.craft-card h3 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.15rem;
  margin: 0 0 6px;
  color: var(--c);
}
.craft-meta {
  font-size: .82rem;
  color: var(--ink-soft);
  line-height: 1.5;
}
.craft-meta strong {
  color: var(--ink);
  font-weight: 700;
}
.craft-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 10px;
}
.craft-link-pill {
  font-size: .78rem;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--ink-faint);
  transition: border-color .15s, color .15s;
}
.craft-card:hover .craft-link-pill {
  border-color: var(--c);
  color: var(--c);
}

@media (max-width: 600px) {
  .craft-grid { grid-template-columns: 1fr; }
}
</style>
